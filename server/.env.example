# ============================================================
# Sao chép file này thành .env rồi điền thông tin thực
#   cp .env.example .env
# ============================================================

# --- Server ---
PORT=5001
# URL server dùng để tạo link trong email kích hoạt tài khoản
BASE_URL=http://localhost:5001

# --- MongoDB ---
# Local (mặc định):
MONGO_URI=mongodb://localhost:27017/instagrams
# Hoặc MongoDB Atlas (thay <username> <password> <cluster>):
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/instagrams

# --- JWT ---
# Đặt chuỗi bí mật bất kỳ, càng dài càng tốt (vd: dùng openssl rand -hex 32)
JWT_SECRET=your_jwt_secret_key_here
# Thời hạn token: 7d = 7 ngày, 1h = 1 giờ
JWT_EXPIRES_IN=7d

# --- Client URL (cho CORS) ---
# URL của Vite dev server (frontend)
CLIENT_URL=http://localhost:5173

# --- Email (Gmail App Password) ---
# Bước 1: Bật xác minh 2 bước tại myaccount.google.com/security
# Bước 2: Tạo App Password tại myaccount.google.com/apppasswords
#          → chọn "Other" → đặt tên bất kỳ → copy 16 ký tự
MAIL_USER=your_gmail@gmail.com
MAIL_PASS=xxxx xxxx xxxx xxxx

# --- AI: gợi ý caption từ ảnh (Gemini Vision) ---
# Lấy key miễn phí tại https://aistudio.google.com/app/apikey
# Có thể thêm key dự phòng (_2, _3...) — key chính hết quota thì code tự nhảy sang
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
# Model có vision, free tier. Nếu gặp lỗi 429 RESOURCE_EXHAUSTED ở gemini-2.0-flash
# thì đổi sang gemini-2.5-flash (quota free thoáng hơn).
GEMINI_MODEL=gemini-2.5-flash

# --- AI: kiểm duyệt nội dung tự động (OpenAI Moderation - miễn phí) ---
# Lấy key tại https://platform.openai.com/api-keys
# Có thể thêm key dự phòng (_2, _3...) — hết quota thì tự nhảy sang
OPENAI_API_KEY=
OPENAI_API_KEY_2=
OPENAI_API_KEY_3=
OPENAI_MODERATION_MODEL=omni-moderation-latest

# --- Cloudinary (KHÔNG dùng) ---
# Dự án hiện lưu file local vào server/uploads/
# Nếu muốn chuyển sang Cloudinary thật, sửa utils/cloudinary.js
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
